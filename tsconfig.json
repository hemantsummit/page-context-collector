{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["ESNext", "DOM"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "verbatimModuleSyntax": false,
        "noFallthroughCasesInSwitch": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
